  <block type="procedures_defnoreturn" id="Screen1_hit_volume_1506" x="40" y="40" collapsed="true">
    <mutation />
    <field name="NAME">应用打击音量</field>
    <statement name="STACK">
      <block type="component_set_get" id="Screen1_hit_volume_1507">
        <mutation component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="打击音量标题" />
