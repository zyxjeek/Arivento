  <block type="component_event" id="Screen1_hit_volume_1525" x="40" y="155" collapsed="true">
    <mutation component_type="Slider" is_generic="false" instance_name="打击音量滑条" event_name="PositionChanged" param_name0="位置" />
    <field name="COMPONENT_SELECTOR">打击音量滑条</field>
